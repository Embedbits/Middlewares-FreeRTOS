# =============================================================================
# FreeRTOSConfig.cmake - project-side FreeRTOS build configuration.
#
# Seeded once next to FreeRTOSConfig.h by the vendored FreeRTOS wrapper
# (Middlewares/ThirdParty/FreeRTOS/CMakeLists.txt) and never overwritten
# afterwards - this file belongs to the project, edit it for your target.
#
# The wrapper include()s this file right before it adds the FreeRTOS kernel,
# so everything set here is visible to the kernel build. Plain (non-cache)
# variables are used on purpose: an edit here takes effect on the next
# configuration run, without deleting the build folder.
# =============================================================================

# -----------------------------------------------------------------------------
# freertos_config - INTERFACE library exposing FreeRTOSConfig.h to the kernel.
# Points at this folder, i.e. the FreeRTOSConfig.h seeded next to this file.
# -----------------------------------------------------------------------------
if(NOT TARGET freertos_config)
    add_library(freertos_config INTERFACE)
    target_include_directories(freertos_config SYSTEM INTERFACE "${CMAKE_CURRENT_LIST_DIR}")
endif()

# -----------------------------------------------------------------------------
# FREERTOS_PORT - kernel port matching the MCU core and the toolchain.
# Required - the configuration stops with an error while it is empty.
#
# Examples (full list: FreeRTOS/Source/CMakeLists.txt, folder names under
# FreeRTOS/Source/portable/<Compiler>/):
#   GCC_ARM_CM0                  Cortex-M0 / M0+           (STM32F0, G0, L0, C0)
#   GCC_ARM_CM3                  Cortex-M3                 (STM32F1, F2, L1)
#   GCC_ARM_CM4F                 Cortex-M4 with FPU        (STM32F3, F4, G4, L4, WB)
#   GCC_ARM_CM7                  Cortex-M7                 (STM32F7, H7)
#   GCC_ARM_CM33_NTZ_NONSECURE   Cortex-M33, TrustZone not used (STM32U5, H5, L5)
#   GCC_ARM_CM33_NONSECURE       Cortex-M33, non-secure side of a TrustZone project
#   GCC_ARM_CM33_SECURE          Cortex-M33, secure side of a TrustZone project
#   GCC_ARM_CM55_NTZ_NONSECURE   Cortex-M55, TrustZone not used
#   GCC_RISC_V                   RISC-V
#   GCC_POSIX                    Host build (Linux / WSL) - simulation, host tests
# -----------------------------------------------------------------------------
set(FREERTOS_PORT "")

# -----------------------------------------------------------------------------
# FREERTOS_HEAP - heap implementation (portable/MemMang/heap_<N>.c), or a path
# to a custom heap source file. Leave empty only when configSUPPORT_DYNAMIC_
# ALLOCATION is 0 (static allocation only) - no heap is compiled then.
#   1   Allocate only, never frees - simplest, deterministic
#   2   Frees, no coalescing of adjacent free blocks (superseded by 4)
#   3   Wraps the C library malloc()/free() (needs a linker heap)
#   4   Frees and coalesces adjacent free blocks - recommended default
#   5   As 4, heap may span several non-contiguous RAM regions
#       (vPortDefineHeapRegions() must be called before first allocation)
# -----------------------------------------------------------------------------
set(FREERTOS_HEAP "4")

# -----------------------------------------------------------------------------
# Optional FreeRTOS components - OFF unless enabled here (list of available
# FREERTOS_ENABLE_<COMPONENT> switches: the vendored FreeRTOS wrapper
# CMakeLists.txt, e.g. Middlewares/ThirdParty/FreeRTOS). Example:
#   set(FREERTOS_ENABLE_FREERTOS_PLUS_TCP ON)
#   set(FREERTOS_PLUS_TCP_NETWORK_IF "STM32HXX") # required by FreeRTOS+TCP (STM32FXX, STM32HXX, ...)
# -----------------------------------------------------------------------------
